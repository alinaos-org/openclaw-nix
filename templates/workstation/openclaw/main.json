{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "auth": {
      "mode": "token",
      "token": "${OPENCLAW_GATEWAY_TOKEN}"
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/@USER@/.openclaw-main/workspace",
      "model": {
        "primary": "@MODEL@"
      }
    }
  }
}
