# One person's NixOS laptop with OpenClaw, generated by openclaw-nix's init:
#
#   nix run github:alinaos-org/openclaw-nix#init -- ./laptop
#
# host.nix is the machine and its user, openclaw.nix the gateway and its secrets,
# openclaw/main.json what the agents do. Rebuild with
# `sudo nixos-rebuild switch --flake .#@HOSTNAME@`, then run `openclaw-doctor`.
{
  inputs = {
    # A release tag, not main: move it with `nix flake update openclaw-nix` (or the
    # flake-update workflow, README "Updates").
    openclaw-nix.url = "github:alinaos-org/openclaw-nix/@OPENCLAW_NIX_REF@";
    nixpkgs.follows = "openclaw-nix/nixpkgs";
    home-manager.follows = "openclaw-nix/nix-openclaw/home-manager";
    sops-nix.follows = "openclaw-nix/sops-nix";
  };

  # The gateway build is cached; without this it compiles locally.
  nixConfig = {
    extra-substituters = ["https://alinaos-openclaw-nix.cachix.org"];
    extra-trusted-public-keys = ["alinaos-openclaw-nix.cachix.org-1:vLkWgaUe6XR3H+bIMF6QvMvxbrZJLFL9WyaVyrRD8Jo="];
  };

  outputs = {
    nixpkgs,
    home-manager,
    sops-nix,
    openclaw-nix,
    ...
  }: {
    nixosConfigurations."@HOSTNAME@" = nixpkgs.lib.nixosSystem {
      system = "x86_64-linux";
      modules = [
        ./hardware-configuration.nix
        home-manager.nixosModules.home-manager
        sops-nix.nixosModules.sops
        openclaw-nix.nixosModules.workstation
        ./host.nix
        ./openclaw.nix
      ];
    };
  };
}
