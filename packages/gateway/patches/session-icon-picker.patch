+  private renderPanelBody(tab: CatalogTab, sections: readonly CatalogSection[], tabStop: CatalogItem | undefined) {
+    return html`
+      ${
+        tab === "emoji" && this.emoji
+          ? html`<div class="session-menu__icon-groups">
+              ${this.emoji.map(
+                (group) => html`<button
+                  type="button"
+                  class="session-menu__icon-group-jump"
+                  aria-label=${t(EMOJI_GROUP_LABELS[group.id])}
+                  title=${t(EMOJI_GROUP_LABELS[group.id])}
+                  tabindex="-1"
+                  @click=${() => this.jumpTo(group.id)}
+                >
+                  ${group.emoji[0]?.emoji}
+                </button>`,
+              )}
+            </div>`
+          : nothing
+      }
+      <div class="session-menu__icon-scroll">
+        ${this.renderSections(sections, tabStop)}
+        ${
+          tab === "emoji" && this.shown && !this.emoji
+            ? html`<div class="session-menu__icon-empty">
+                ${t(this.loadFailed ? "sessionsView.iconEmojiLoadFailed" : "sessionsView.iconEmojiLoading")}
+              </div>`
+            : nothing
+        }
+      </div>
+    `;
+  }
+
+  override render() {
+    const tab = this.activeTab;
+    const searching = Boolean(this.query.trim());
+    const sections = this.sections();
+    const items = sections.flatMap((section) => section.items);
+    const tabStop = items.find((item) => item.pressed) ?? items[0];
