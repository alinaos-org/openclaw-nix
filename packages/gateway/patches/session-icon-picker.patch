+                  ${t(name === "emoji" ? "sessionsView.iconEmojiSection" : "sessionsView.iconGlyphSection")}
+                </wa-tab>`,
+              )}
+              ${(["emoji", "icons"] as const).map(
+                (name) => html`<wa-tab-panel
+                  id=${`${id}-${name}-panel`}
+                  aria-labelledby=${`${id}-${name}-tab`}
+                  name=${name}
+                  ?active=${tab === name}
+                >
+                  ${tab === name ? this.renderPanelBody(name, sections, tabStop) : nothing}
+                </wa-tab-panel>`,
+              )}
+            </wa-tab-group>`
+      }
+      </div>
+    `;
+  }
+}
+
+if (!customElements.get("openclaw-session-icon-catalog")) {
+  customElements.define("openclaw-session-icon-catalog", SessionIconCatalog);
+}
