+import { html, nothing, type TemplateResult } from "lit";
+import { property, state } from "lit/decorators.js";
+import { ifDefined } from "lit/directives/if-defined.js";
+import { ref } from "lit/directives/ref.js";
+import {
+  SESSION_ICON_GLYPH_IDS,
+  SESSION_ICON_SVG_DATA_URL_PREFIX,
+} from "../../../packages/gateway-protocol/src/session-agent-status.js";
+import { t } from "../i18n/index.ts";
+import { OpenClawLightDomElement } from "../lit/openclaw-element.ts";
+import { icons } from "./icons.ts";
+import type { SessionEmojiGroupId } from "./session-icon-emoji-data.ts";
+import { resolveSessionIconGraphic } from "./session-icon-glyph-registry.ts";
+import { syncTabGroupLabel } from "./web-awesome-tabs.ts";
+import {
+  isSessionIconLibraryIcon,
+  sessionIconLibrary,
+  sessionIconLibraryGroups,
+  type SessionIconLibraryGroup,
+  type SessionIconLibraryIcon,
+} from "./session-icon-library.ts";
+
+/** The emoji offered first, before any recent choice. */
+export const SESSION_ICON_EMOJI_CHOICES = [
+  "🦞",
+  "🚀",
+  "🐛",
+  "✅",
+  "🔥",
+  "📦",
+  "🧪",
+  "📝",
+  "🔍",
+  "⚡",
+  "🎯",
+] as const;
+
+export type SessionEmoji = { emoji: string; name: string; subgroup: string };
+export type SessionEmojiGroup = { id: SessionEmojiGroupId; emoji: readonly SessionEmoji[] };
+
+/** Parse one generated group: "@<subgroup>" lines start a subgroup, others are "<emoji> <name>". */
+export function parseSessionEmojiGroup(group: {
+  id: SessionEmojiGroupId;
+  data: string;
+}): SessionEmojiGroup {
+  const emoji: SessionEmoji[] = [];
+  let subgroup = "";
+  for (const line of group.data.split("\n")) {
+    if (line.startsWith("@")) {
+      subgroup = line.slice(1);
+      continue;
+    }
+    const space = line.indexOf(" ");
+    if (space > 0) {
+      emoji.push({ emoji: line.slice(0, space), name: line.slice(space + 1), subgroup });
+    }
+  }
+  return { id: group.id, emoji };
+}
+
+let emojiLoad: Promise<readonly SessionEmojiGroup[]> | undefined;
+
+/** Every emoji the picker offers, loaded on first use (its own chunk). */
+export function loadSessionEmoji(): Promise<readonly SessionEmojiGroup[]> {
+  emojiLoad ??= import("./session-icon-emoji-data.ts").then(({ SESSION_EMOJI_GROUPS }) =>
+    SESSION_EMOJI_GROUPS.map(parseSessionEmojiGroup),
+  );
+  return emojiLoad;
+}
+
+function searchTerms(query: string): string[] {
+  return query.trim().toLowerCase().split(/\s+/u).filter(Boolean);
+}
+
+// A term matches a word or, with spaces and punctuation ignored, run-together words
+// ("homelab" finds "home lab"); a plural also matches its singular ("dogs").
+function matchesTerms(text: string, terms: readonly string[]): boolean {
+  const haystack = text.toLowerCase();
+  const compact = haystack.replace(/[^\p{L}\p{N}]+/gu, "");
+  const matches = (term: string) => haystack.includes(term) || compact.includes(term);
+  return terms.every(
+    (term) => matches(term) || (term.length > 3 && term.endsWith("s") && matches(term.slice(0, -1))),
+  );
+}
+
+/** Emoji whose name or subgroup contains every search term, in catalog order. */
+export function searchSessionEmoji(
+  groups: readonly SessionEmojiGroup[],
+  query: string,
+): SessionEmoji[] {
+  const terms = searchTerms(query);
+  if (!terms.length) {
+    return [];
+  }
+  return groups.flatMap((group) =>
+    group.emoji.filter((entry) =>
+      matchesTerms(`${entry.name} ${entry.subgroup.replaceAll("-", " ")}`, terms),
+    ),
+  );
+}
+
+/** Built-in glyphs whose name contains every search term. */
+export function searchSessionIconGlyphs(query: string): string[] {
+  const terms = searchTerms(query);
+  return terms.length ? SESSION_ICON_GLYPH_IDS.filter((id) => matchesTerms(id, terms)) : [];
+}
+
+export function sessionIconLibraryLabel(icon: SessionIconLibraryIcon): string {
+  return t(`sessionsView.iconLibrary.icons.${icon.id}`);
+}
+
+export function sessionIconLibraryGroupLabel(group: SessionIconLibraryGroup): string {
+  return t(`sessionsView.iconLibrary.groups.${group}`);
+}
+
+/** Library icons whose name, group name or keywords contain every search term. */
+export function searchSessionIconLibrary(query: string): SessionIconLibraryIcon[] {
+  const terms = searchTerms(query);
+  if (!terms.length) {
+    return [];
+  }
+  return sessionIconLibrary().filter((icon) =>
+    matchesTerms(
+      `${sessionIconLibraryLabel(icon)} ${sessionIconLibraryGroupLabel(icon.group)} ${icon.keywords}`,
+      terms,
+    ),
+  );
+}
+
+// Recent choices are this browser's presentation state, not session data.
+const RECENT_KEY = "openclaw.control-ui.session-icons.recent.v1";
+const RECENT_LIMIT = 18;
+
+export function recentSessionIcons(): string[] {
+  try {
+    const value: unknown = JSON.parse(globalThis.localStorage?.getItem(RECENT_KEY) ?? "[]");
+    return Array.isArray(value)
+      ? value.filter((icon): icon is string => typeof icon === "string").slice(0, RECENT_LIMIT)
+      : [];
+  } catch {
+    return [];
+  }
+}
+
+export function rememberSessionIcon(icon: string) {
+  try {
+    const recent = [icon, ...recentSessionIcons().filter((entry) => entry !== icon)];
+    globalThis.localStorage?.setItem(RECENT_KEY, JSON.stringify(recent.slice(0, RECENT_LIMIT)));
+  } catch {
+    // Storage may be unavailable (private mode, quota); recents are optional.
+  }
+}
+
+export type SessionIconCatalogProps = {
+  currentIcon: string | null;
+  allowSvg: boolean;
+  clearable: boolean;
+  disabled: boolean;
+  disabledReason?: string;
+  onSelect: (event: MouseEvent, icon: string | null) => void;
+  onShowCustom: (event: MouseEvent) => void;
+};
+
+type CatalogTab = "emoji" | "icons";
+
+type CatalogItem = {
+  value: string | null;
+  kind: "emoji" | "glyph" | "image";
+  label: string;
+  pressed: boolean;
+};
+
+type CatalogSection = {
+  label: string;
+  items: CatalogItem[];
+  group?: SessionEmojiGroupId;
+  custom?: boolean;
+};
+
+const EMOJI_GROUP_LABELS = {
+  smileys: "sessionsView.iconEmojiGroups.smileys",
+  people: "sessionsView.iconEmojiGroups.people",
+  animals: "sessionsView.iconEmojiGroups.animals",
+  food: "sessionsView.iconEmojiGroups.food",
+  travel: "sessionsView.iconEmojiGroups.travel",
+  activities: "sessionsView.iconEmojiGroups.activities",
+  objects: "sessionsView.iconEmojiGroups.objects",
+  symbols: "sessionsView.iconEmojiGroups.symbols",
+  flags: "sessionsView.iconEmojiGroups.flags",
+} as const satisfies Record<SessionEmojiGroupId, string>;
+
+const SEARCH_RESULT_LIMIT = 240;
+
+let catalogInstances = 0;
+
+/**
+ * The picker's icon choices: Emoji and Icons tabs over every emoji and the icon
+ * library, with search across both. Light DOM, so the session menu's styles,
+ * focus handling and arrow-key grid navigation apply to its choices.
+ */
+export class SessionIconCatalog extends OpenClawLightDomElement {
+  @property({ attribute: false }) props!: SessionIconCatalogProps;
+  @state() private tab: CatalogTab | null = null;
+  @state() private query = "";
+  @state() private emoji: readonly SessionEmojiGroup[] | null = null;
+  @state() private loadFailed = false;
+  // The session menu renders this inside a closed submenu whenever it opens. Until
+  // the picker is shown, render only its first section; then every choice.
+  @state() private shown = typeof IntersectionObserver === "undefined";
+  private observer?: IntersectionObserver;
+  private readonly instance = ++catalogInstances;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    if (this.shown) {
+      this.loadEmoji();
+      return;
+    }
+    this.observer = new IntersectionObserver((entries) => {
+      if (entries.some((entry) => entry.isIntersecting)) {
+        this.observer?.disconnect();
+        this.observer = undefined;
+        this.shown = true;
+        this.loadEmoji();
+      }
+    });
+    this.observer.observe(this);
+  }
+
+  override disconnectedCallback() {
+    this.observer?.disconnect();
+    this.observer = undefined;
+    super.disconnectedCallback();
+  }
+
+  private loadEmoji() {
+    if (this.emoji) {
+      return;
+    }
+    loadSessionEmoji().then(
+      (groups) => {
+        this.emoji = groups;
+      },
+      () => {
+        this.loadFailed = true;
+      },
+    );
+  }
+
+  private get activeTab(): CatalogTab {
+    if (this.tab) {
+      return this.tab;
+    }
+    const current = this.props.currentIcon;
+    if (current === null) {
+      return "emoji";
+    }
+    if (SESSION_ICON_GLYPH_IDS.some((id) => id === current)) {
+      return "icons";
+    }
+    return this.props.allowSvg && current.startsWith(SESSION_ICON_SVG_DATA_URL_PREFIX)
+      ? "icons"
+      : "emoji";
+  }
+
+  private emojiItem(entry: { emoji: string; name: string }): CatalogItem {
+    return {
+      value: entry.emoji,
+      kind: "emoji",
+      label: entry.name,
+      pressed: this.props.currentIcon === entry.emoji,
+    };
+  }
+
+  private glyphItem(id: string): CatalogItem {
+    return { value: id, kind: "glyph", label: id, pressed: this.props.currentIcon === id };
+  }
+
+  private libraryItem(icon: SessionIconLibraryIcon): CatalogItem {
+    return {
+      value: icon.value,
+      kind: "image",
+      label: sessionIconLibraryLabel(icon),
+      pressed: isSessionIconLibraryIcon(this.props.currentIcon, icon),
+    };
+  }
+
+  private emojiName(emoji: string): string {
+    for (const group of this.emoji ?? []) {
+      const entry = group.emoji.find((candidate) => candidate.emoji === emoji);
+      if (entry) {
+        return entry.name;
+      }
+    }
+    return emoji;
+  }
+
+  private recentEmojiSection(): CatalogSection {
+    const recent = recentSessionIcons().filter(
+      (icon) =>
+        !icon.startsWith(SESSION_ICON_SVG_DATA_URL_PREFIX) &&
+        !SESSION_ICON_GLYPH_IDS.some((id) => id === icon),
+    );
+    const choices = [...new Set([...recent, ...SESSION_ICON_EMOJI_CHOICES])].slice(
+      0,
+      Math.max(RECENT_LIMIT, SESSION_ICON_EMOJI_CHOICES.length),
+    );
+    return {
+      label: t("sessionsView.iconRecentSection"),
+      items: choices.map((emoji) => this.emojiItem({ emoji, name: this.emojiName(emoji) })),
+      custom: true,
+    };
+  }
+
+  private builtInSection(): CatalogSection {
+    return {
+      label: t("sessionsView.iconBuiltInSection"),
+      items: [
+        ...(this.props.clearable
+          ? [
+              {
+                value: null,
+                kind: "glyph",
+                label: t("sessionsView.noIcon"),
+                pressed: this.props.currentIcon === null,
+              } satisfies CatalogItem,
+            ]
+          : []),
+        ...SESSION_ICON_GLYPH_IDS.map((id) => this.glyphItem(id)),
+      ],
+      custom: true,
+    };
+  }
+
+  private librarySections(): CatalogSection[] {
+    if (!this.props.allowSvg) {
+      return [];
+    }
+    const library = sessionIconLibrary();
+    return sessionIconLibraryGroups().map((group) => ({
+      label: sessionIconLibraryGroupLabel(group),
+      items: library.filter((icon) => icon.group === group).map((icon) => this.libraryItem(icon)),
+    }));
+  }
+
+  private sections(): CatalogSection[] {
+    if (this.query.trim()) {
+      const emoji = searchSessionEmoji(this.emoji ?? [], this.query)
+        .slice(0, SEARCH_RESULT_LIMIT)
+        .map((entry) => this.emojiItem(entry));
+      const iconItems = [
+        ...searchSessionIconGlyphs(this.query).map((id) => this.glyphItem(id)),
+        ...(this.props.allowSvg
+          ? searchSessionIconLibrary(this.query).map((icon) => this.libraryItem(icon))
+          : []),
+      ];
+      return [
+        ...(emoji.length ? [{ label: t("sessionsView.iconEmojiSection"), items: emoji }] : []),
+        ...(iconItems.length ? [{ label: t("sessionsView.iconGlyphSection"), items: iconItems }] : []),
+      ];
+    }
+    if (this.activeTab === "icons") {
+      return [this.builtInSection(), ...(this.shown ? this.librarySections() : [])];
+    }
+    if (!this.shown) {
+      return [this.recentEmojiSection()];
+    }
+    return [
+      this.recentEmojiSection(),
+      ...(this.emoji ?? []).map((group) => ({
+        label: t(EMOJI_GROUP_LABELS[group.id]),
+        group: group.id,
+        items: group.emoji.map((entry) => this.emojiItem(entry)),
+      })),
+    ];
+  }
+
+  private select(event: MouseEvent, icon: string | null) {
+    if (icon !== null) {
+      rememberSessionIcon(icon);
+    }
+    this.props.onSelect(event, icon);
+  }
+
+  private selectTab(tab: CatalogTab) {
+    this.tab = tab;
+    this.query = "";
