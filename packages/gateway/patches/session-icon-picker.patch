+/* @vitest-environment jsdom */
+
+import { createHash } from "node:crypto";
+import { render } from "lit";
+import { afterEach, beforeEach, describe, expect, it, vi } from "vitest";
+import { normalizeSessionIconValue } from "../../../packages/gateway-protocol/src/session-agent-status.js";
+import { waitForFast } from "../test-helpers/wait-for.ts";
+import {
+  loadSessionEmoji,
+  parseSessionEmojiGroup,
+  recentSessionIcons,
+  searchSessionEmoji,
+  searchSessionIconGlyphs,
+  searchSessionIconLibrary,
+  type SessionIconCatalog,
+} from "./session-icon-catalog.ts";
+import { SESSION_EMOJI_COUNT, SESSION_EMOJI_GROUPS } from "./session-icon-emoji-data.ts";
+import {
+  findSessionIconLibraryIcon,
+  sessionIconLibrary,
+  sessionIconLibraryGroups,
+} from "./session-icon-library.ts";
+import { SESSION_ICON_LIBRARY_SAVED_VALUES } from "./session-icon-library.values.test-support.ts";
+import { renderAppearancePicker } from "./session-icon-picker.ts";
+
+const sha256 = (value: string) => createHash("sha256").update(value).digest("hex");
+const savedValues = SESSION_ICON_LIBRARY_SAVED_VALUES;
+
+describe("session icon emoji", () => {
+  it("offers every emoji through Emoji 16.0 that the gateway accepts, in nine groups", () => {
+    const groups = SESSION_EMOJI_GROUPS.map(parseSessionEmojiGroup);
+    expect(groups.map((group) => group.id)).toEqual([
+      "smileys",
+      "people",
+      "animals",
+      "food",
+      "travel",
+      "activities",
+      "objects",
+      "symbols",
+      "flags",
+    ]);
+    const all = groups.flatMap((group) => group.emoji);
+    expect(all).toHaveLength(SESSION_EMOJI_COUNT);
+    expect(SESSION_EMOJI_COUNT).toBeGreaterThan(1800);
+    expect(new Set(all.map((entry) => entry.emoji)).size).toBe(all.length);
+    expect(all.filter((entry) => /[\u{1F3FB}-\u{1F3FF}]/u.test(entry.emoji))).toEqual([]);
+    for (const entry of all) {
+      expect(normalizeSessionIconValue(entry.emoji), entry.name).toBe(entry.emoji);
+    }
+  });
+
+  it("searches names and subgroups with every term", async () => {
+    const groups = await loadSessionEmoji();
+    expect(searchSessionEmoji(groups, "dog").map((entry) => entry.emoji)).toEqual(
+      expect.arrayContaining(["🐶", "🐕"]),
+    );
+    expect(searchSessionEmoji(groups, "RED heart").map((entry) => entry.emoji)).toContain("❤️");
+    expect(searchSessionEmoji(groups, "animal mammal").length).toBeGreaterThan(30);
+    expect(searchSessionEmoji(groups, "dogs").map((entry) => entry.emoji)).toContain("🐕");
+    expect(searchSessionEmoji(groups, "   ")).toEqual([]);
+  });
+});
+
+describe("session icon library", () => {
+  it("keeps 72 icons in nine groups that the gateway accepts", () => {
+    const library = sessionIconLibrary();
+    expect(library).toHaveLength(72);
+    expect(sessionIconLibraryGroups()).toHaveLength(9);
+    expect(new Set(library.map((icon) => icon.value)).size).toBe(72);
+    for (const icon of library) {
+      expect(normalizeSessionIconValue(icon.value), icon.id).toBe(icon.value);
+    }
+  });
+
+  it("saves the plugin's values byte for byte and recognises its older ones", () => {
+    const library = sessionIconLibrary();
+    expect(library.map((icon) => icon.id)).toEqual(savedValues.map((row) => row.id));
+    for (const [index, icon] of library.entries()) {
+      const saved = savedValues[index];
+      expect(sha256(icon.value), `${icon.id}: bold`).toBe(saved?.bold);
+      expect(sha256(icon.previousValue), `${icon.id}: pastel`).toBe(saved?.pastel);
+      expect(sha256(icon.legacyValue), `${icon.id}: outline`).toBe(saved?.outline);
+      expect(findSessionIconLibraryIcon(icon.previousValue)).toBe(icon);
+      expect(findSessionIconLibraryIcon(icon.legacyValue)).toBe(icon);
+    }
+  });
+
+  it("searches labels, groups and keywords", () => {
+    expect(searchSessionIconLibrary("simulink").map((icon) => icon.id)).toContain("simulation");
+    expect(searchSessionIconLibrary("homelab").length).toBeGreaterThan(0);
+    expect(searchSessionIconGlyphs("BOT")).toEqual(["bot"]);
+  });
+});
+
+describe("session icon picker", () => {
+  let host: HTMLElement;
+  beforeEach(() => {
+    localStorage.clear();
+    host = document.createElement("div");
+    document.body.append(host);
+  });
+  afterEach(() => host.remove());
+
+  function mount(overrides: Partial<Parameters<typeof renderAppearancePicker>[0]> = {}) {
+    const onSelect = vi.fn();
+    render(
+      renderAppearancePicker({
+        inline: true,
+        allowSvg: true,
+        mode: "grid",
+        currentIcon: null,
+        currentColor: null,
+        colorDisabled: false,
+        onSelectColor: () => {},
+        onReset: () => {},
+        customIconValue: "",
+        disabled: false,
+        onSelect,
+        onShowCustom: () => {},
+        onBack: () => {},
+        onInput: () => {},
+        onApply: () => {},
+        onGridKeydown: () => {},
+        ...overrides,
+      }),
+      host,
+    );
+    const catalog = host.querySelector<SessionIconCatalog>("openclaw-session-icon-catalog");
+    if (!catalog) {
+      throw new Error("Expected the icon catalog");
+    }
+    return { catalog, onSelect };
+  }
+
+  const labels = () =>
+    Array.from(host.querySelectorAll(".session-menu__icon-scroll .session-menu__icon-section-label")).map(
+      (label) => label.textContent?.trim(),
+    );
+
+  async function search(catalog: SessionIconCatalog, query: string) {
+    const input = host.querySelector<HTMLInputElement>(".session-menu__icon-search");
+    if (!input) {
+      throw new Error("Expected the search box");
+    }
+    input.value = query;
+    input.dispatchEvent(new InputEvent("input", { bubbles: true }));
+    await catalog.updateComplete;
+  }
+
+  it("lists every emoji by category and jumps to a category", async () => {
+    const { catalog } = mount({ currentIcon: "🦞" });
+    await waitForFast(() => expect(labels()).toHaveLength(10));
+    expect(labels()[0]).toBe("Frequently used");
+    expect(labels().slice(1)).toEqual([
+      "Smileys & emotion",
+      "People & body",
+      "Animals & nature",
+      "Food & drink",
+      "Travel & places",
+      "Activities",
+      "Objects",
+      "Symbols",
+      "Flags",
+    ]);
+    // The 11 defaults, the custom-entry cell and every emoji.
+    expect(host.querySelectorAll(".session-menu__icon-scroll .session-menu__icon-choice").length).toBe(
+      11 + SESSION_EMOJI_COUNT + 1,
+    );
+    expect(host.querySelectorAll(".session-menu__icon-group-jump")).toHaveLength(9);
+    expect(catalog.isConnected).toBe(true);
+  });
+
+  it("opens Icons for a library icon and marks its older pastel value as selected", async () => {
+    const icon = sessionIconLibrary().find((entry) => entry.id === "aircraft");
+    if (!icon) {
+      throw new Error("Expected the aircraft icon");
+    }
+    const { catalog } = mount({ currentIcon: icon.previousValue });
+    await catalog.updateComplete;
+    expect(host.querySelector("wa-tab[active]")?.textContent?.trim()).toBe("Icons");
+    expect(labels()).toEqual([
+      "Built-in",
+      "Aerospace & simulation",
+      "AI & agents",
+      "Code & tools",
+      "Home lab & infrastructure",
+      "Security & reliability",
+      "Business & career",
+      "Finance & markets",
+      "Creative & media",
+      "Life & interests",
+    ]);
+    const pressed = host.querySelectorAll<HTMLButtonElement>(
+      '.session-menu__icon-choice[aria-pressed="true"]',
+    );
+    expect(Array.from(pressed).map((choice) => choice.getAttribute("aria-label"))).toEqual([
+      "Aircraft",
+    ]);
+    expect(pressed[0]?.tabIndex).toBe(0);
+  });
+
+  it("searches emoji and icons together and selects the saved value", async () => {
+    const { catalog, onSelect } = mount();
+    await loadSessionEmoji();
+    await search(catalog, "rocket");
+    expect(labels()).toEqual(["Emoji"]);
+    await search(catalog, "simulink");
+    expect(labels()).toEqual(["Icons"]);
+    host.querySelector<HTMLButtonElement>('[aria-label="Simulation blocks"]')?.click();
+    const value = sessionIconLibrary().find((icon) => icon.id === "simulation")?.value;
+    expect(onSelect).toHaveBeenCalledWith(expect.any(MouseEvent), value);
+    await search(catalog, "zzzz qqqq");
+    expect(labels()).toEqual([]);
+    expect(host.querySelector(".session-menu__icon-empty")?.textContent?.trim()).toBe(
+      "Nothing matches “zzzz qqqq”.",
+    );
+  });
+
+  it("puts a chosen emoji first in Frequently used", async () => {
+    const { catalog, onSelect } = mount({ currentIcon: "🦞" });
+    await loadSessionEmoji();
+    await search(catalog, "dog face");
+    host.querySelector<HTMLButtonElement>('[aria-label="dog face"]')?.click();
+    expect(onSelect).toHaveBeenCalledWith(expect.any(MouseEvent), "🐶");
+    expect(recentSessionIcons()).toEqual(["🐶"]);
+    await search(catalog, "");
+    const first = host.querySelector(".session-menu__icon-grid .session-menu__icon-choice");
+    expect(first?.textContent?.trim()).toBe("🐶");
+  });
+
+  it("offers only built-in icons where SVG icons are not allowed", async () => {
+    const { catalog } = mount({ allowSvg: false, currentIcon: "bot" });
+    await catalog.updateComplete;
+    expect(labels()).toEqual(["Built-in"]);
+    expect(host.querySelectorAll(".session-menu__icon-choice img")).toHaveLength(0);
+  });
+});
