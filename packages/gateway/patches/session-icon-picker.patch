+// The bold session icon library: 72 original icons in nine groups, from openclaw-nix's
+// session-icons plugin (0.2.0), now part of the built-in picker. Each value is a
+// self-contained SVG data URL and stays byte for byte what the plugin saved, so saved
+// sessions keep matching: the pastel artwork (0.1) and the first one-colour outlines
+// still count as the same icon. The artwork is original to openclaw-nix (MIT).
+import { SESSION_ICON_SVG_DATA_URL_PREFIX } from "../../../packages/gateway-protocol/src/session-agent-status.js";
+
+/** Library groups, in order; their names are sessionsView.iconLibrary.groups.<key>. */
+export const SESSION_ICON_LIBRARY_GROUPS = [
+  "aerospace",
+  "ai",
+  "code",
+  "homelab",
+  "security",
+  "business",
+  "finance",
+  "creative",
+  "life",
+] as const;
+
+export type SessionIconLibraryGroup = (typeof SESSION_ICON_LIBRARY_GROUPS)[number];
+
+type SessionIconLibraryDefinition = {
+  /** Also the key of its name, sessionsView.iconLibrary.icons.<id>. */
+  id: string;
+  group: SessionIconLibraryGroup;
+  /** Search words beyond the icon's and group's names. */
+  keywords: string;
+  /** The first build's one-colour outline, kept to recognise values it saved. */
+  path: string;
+};
+
+export type SessionIconLibraryIcon = SessionIconLibraryDefinition & {
+  /** The value a selection saves. */
+  value: string;
+  /** The 0.1 pastel value. */
+  previousValue: string;
+  /** The first build's outline value. */
+  legacyValue: string;
+};
+
+// Recolour only paint attributes of the original artwork: geometry, whitespace and
+// encoding stay intact, so the pastel values remain reproducible.
+const BOLD_PALETTE: Readonly<Record<string, string>> = {
+  "#38bdf8": "#0085ff", // blue
+  "#a78bfa": "#7030e8", // violet
+  "#fb923c": "#f47700", // orange
+  "#f472b6": "#e91e8f", // magenta
+  "#34d399": "#00ad73", // emerald
+  "#facc15": "#ffc400", // gold
+  "#22d3ee": "#00b8d4", // cyan
+  "#fb7185": "#ed2033", // red
+  "#334155": "#1e293b", // ink
+  "#f8fafc": "#ffffff", // highlight
+};
+
+const colourSource = (id: string, bold = true) => {
+  const original = ARTWORK[id];
+  if (original === undefined) {
+    throw new Error(`session icon library: no artwork for ${id}`);
+  }
+  const artwork = bold
+    ? original.replace(/#[0-9a-f]{6}/gu, (colour) => BOLD_PALETTE[colour] ?? colour)
+    : original;
+  return `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">${artwork}</svg>`;
+};
+const outlineSource = (path: string) =>
+  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="#7a92c2" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="${path}"/></svg>`;
+const dataUrl = (svg: string) => `${SESSION_ICON_SVG_DATA_URL_PREFIX}${encodeURIComponent(svg)}`;
+
+let library: readonly SessionIconLibraryIcon[] | undefined;
+
+/** Every library icon, in its groups' order. */
+export function sessionIconLibrary(): readonly SessionIconLibraryIcon[] {
+  library ??= DEFINITIONS.map((icon) => ({
+    ...icon,
+    value: dataUrl(colourSource(icon.id)),
+    previousValue: dataUrl(colourSource(icon.id, false)),
+    legacyValue: dataUrl(outlineSource(icon.path)),
+  }));
+  return library;
+}
+
+/** The library's groups, in order. */
+export function sessionIconLibraryGroups(): readonly SessionIconLibraryGroup[] {
+  return SESSION_ICON_LIBRARY_GROUPS;
+}
+
+/** Whether a saved icon value is this library icon, in any of its versions. */
+export function isSessionIconLibraryIcon(current: string | null, icon: SessionIconLibraryIcon) {
+  return (
+    current === icon.value || current === icon.previousValue || current === icon.legacyValue
+  );
+}
+
+/** The library icon a saved value is, if any. */
+export function findSessionIconLibraryIcon(current: string | null) {
+  return current ? sessionIconLibrary().find((icon) => isSessionIconLibraryIcon(current, icon)) : undefined;
+}
