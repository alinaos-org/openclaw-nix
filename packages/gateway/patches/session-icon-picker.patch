+    const tabsLabel = t("sessionsView.setIconMenu");
+    return html`
+      <input
+        type="search"
+        class="session-menu__icon-search"
+        autocomplete="off"
+        spellcheck="false"
+        placeholder=${t("sessionsView.iconSearch")}
+        aria-label=${t("sessionsView.iconSearch")}
+        .value=${this.query}
+        @click=${(event: Event) => event.stopPropagation()}
+        @input=${this.onSearchInput}
+        @keydown=${this.onSearchKeydown}
+      />
+      <div class="session-menu__icon-body">
+      ${
+        searching
+          ? html`<div class="session-menu__icon-scroll session-menu__icon-results">
+              ${this.renderSections(sections, tabStop)}
+              ${
+                sections.length
+                  ? nothing
+                  : html`<div class="session-menu__icon-empty">
+                      ${t("sessionsView.iconSearchEmpty", { query: this.query.trim() })}
+                    </div>`
+              }
+            </div>`
+          : html`<wa-tab-group
+              class="session-menu__icon-tabs"
+              aria-label=${tabsLabel}
+              .active=${tab}
+              activation="auto"
+              without-scroll-controls
+              ${ref((element) => syncTabGroupLabel(element, tabsLabel))}
+              @wa-tab-show=${this.onTabShow}
+            >
+              ${(["emoji", "icons"] as const).map(
+                (name) => html`<wa-tab
+                  slot="nav"
+                  id=${`${id}-${name}-tab`}
+                  aria-controls=${`${id}-${name}-panel`}
+                  panel=${name}
+                  ?active=${tab === name}
