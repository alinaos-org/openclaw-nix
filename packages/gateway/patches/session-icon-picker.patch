+  private onSearchInput = (event: InputEvent) => {
+    if (event.currentTarget instanceof HTMLInputElement) {
+      this.query = event.currentTarget.value;
+    }
+  };
+
+  // Keys typed into the search box are text, not menu navigation or type-ahead.
+  private onSearchKeydown = (event: KeyboardEvent) => {
+    if (event.key === "Tab") {
+      return;
+    }
+    if (event.key === "Escape") {
+      if (!this.query) {
+        return;
+      }
+      event.preventDefault();
+      this.query = "";
+    } else if (event.key === "ArrowDown") {
+      event.preventDefault();
+      this.querySelector<HTMLButtonElement>(
+        '.session-menu__icon-scroll .session-menu__icon-choice[tabindex="0"]',
+      )?.focus();
+    }
+    event.stopPropagation();
+  };
+
+  private jumpTo(group: SessionEmojiGroupId) {
+    this.querySelector(`[data-emoji-group="${group}"]`)?.scrollIntoView?.({ block: "start" });
+  }
+
+  private renderItem(item: CatalogItem, tabStop: CatalogItem | undefined): TemplateResult {
+    const graphic =
+      item.value === null
+        ? icons.circleX
+        : item.kind === "emoji"
+          ? item.value
+          : resolveSessionIconGraphic(item.value);
